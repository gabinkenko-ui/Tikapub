# --- TikTok Content Posting API ---
# https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Obtenus via `tikapub auth` (flux OAuth2 authorization_code) puis rafraîchis automatiquement.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# URL de redirection déclarée dans l'app TikTok Developer
TIKTOK_REDIRECT_URI=http://localhost:8787/callback

# --- Génération de script par IA (optionnel, pour le générateur "voiceover") ---
OPENAI_API_KEY=

# --- Chemins (optionnel, valeurs par défaut sinon) ---
TIKAPUB_ASSETS_DIR=assets
TIKAPUB_OUTPUT_DIR=output
